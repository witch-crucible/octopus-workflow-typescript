# 显式远端同步时使用。API Key 必须是仅注入后端的 service_role 凭证；不要提交真实凭据。
CLOUDBASE_ENV_ID=YOUR_ENV_ID
CLOUDBASE_APIKEY=YOUR_SERVICE_ROLE_API_KEY

# 仅数据库迁移使用。填写 CloudBase 控制台展示的 PostgreSQL 直连信息。
CLOUDBASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/octopus?sslmode=require

# 仅废弃的 Supabase 兼容接口读取 DATABASE_URL；storage sync 不会回退。
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/octopus?sslmode=require
