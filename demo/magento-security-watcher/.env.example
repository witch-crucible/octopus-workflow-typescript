# Copy to project root as `.env` (gitignored). Do not commit real secrets.
#   cp .env.example .env

# Optional: absolute project root when cwd is elsewhere
# MSW_ROOT=/data/www/D1M/magento-security-watcher

# WeCom group bot webhook
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE

# LLM (when llm.enabled: true in settings.yaml)
# MSW_LLM_API_KEY=
# OPENAI_API_KEY=

# Optional NVD key
# NVD_API_KEY=

# Magento marketplace keys (isolated patch zips that need auth)
# MAGENTO_REPO_PUBLIC_KEY=
# MAGENTO_REPO_PRIVATE_KEY=
