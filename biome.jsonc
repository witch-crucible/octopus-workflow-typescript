{
  "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noConfusingVoidType": "error",
        "noFallthroughSwitchClause": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useImportType": "error",
        "noNonNullAssertion": "error",
        "useEnumInitializers": "off",
        "noParameterAssign": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/desktop/vite.renderer.config.ts",
        "packages/desktop/src/renderer/main.tsx",
        "packages/desktop/src/renderer/vite-env.d.ts",
        "packages/desktop/src/renderer/components/ui/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/desktop/src/renderer/views/**",
        "packages/desktop/src/renderer/visualizations/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noControlCharactersInRegex": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/cli/src/commands/checklist.ts",
        "packages/cli/src/commands/task.ts",
        "packages/integration/src/git.ts",
        "packages/integration/src/teambition.ts",
        "packages/workflow-engine/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/integration/src/teambition.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/agent-layer/src/modules/registry.ts",
        "packages/core/src/agent.ts",
        "packages/core/src/artifact.ts",
        "packages/core/src/checklist.ts",
        "packages/core/src/phase.ts",
        "packages/core/src/task.ts",
        "packages/core/src/workflow.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/cli/src/commands/ai.ts",
        "packages/cli/src/commands/heinrich.ts",
        "packages/cli/src/commands/status.ts",
        "packages/integration/src/index.ts",
        "packages/workflow-engine/src/index.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ],
  // Formatter/assist 保留给编辑器和显式 biome check；pnpm verify 只门禁 linter，避免本次批量改写历史文件。
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/build", "!**/.next", "!**/.nuxt", "!**/coverage", "!**/*.tsbuildinfo"]
  }
}
