{
  "name": "octopus-workflow-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "AI 项目流程自动化引擎 — multi-agent workflow orchestration",
  "type": "module",
  "scripts": {
    "build": "pnpm -r exec tsc --noEmit",
    "web": "pnpm --filter @octopus/desktop web",
    "lint": "biome lint --diagnostic-level=error packages/ workflow/nodes/*/src/ workflow/nodes/*/test/",
    "lint:fix": "biome lint --write --diagnostic-level=error packages/ workflow/nodes/*/src/ workflow/nodes/*/test/",
    "test": "node scripts/ensure-sqlite.mjs node && vitest run",
    "test:watch": "node scripts/ensure-sqlite.mjs node && vitest",
    "verify": "bash scripts/verify.sh",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "vitest": "^4.1.10"
  }
}
